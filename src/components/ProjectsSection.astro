---
const { id, projects } = Astro.props;
---
<section id={id} class="max-w-5xl mx-auto px-6 py-16">
  <div class="mb-10 flex flex-col gap-4">
    <p class="text-sm uppercase tracking-[0.2em] text-violet-300">Projects</p>
    <h2 class="text-4xl font-semibold tracking-tight text-white sm:text-5xl">Selected work</h2>
  </div>
  <div class="grid gap-6 sm:grid-cols-2">
    {projects.map((project) => (
      <article class="rounded-[1.25rem] bg-white/5 p-7 shadow-[0_18px_50px_rgba(0,0,0,0.05)]">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-violet-300">{project.type}</p>
          <h3 class="mt-4 text-2xl font-semibold text-white">{project.name}</h3>
          <p class="mt-3 text-slate-300 leading-7">{project.description}</p>
        </div>
        <a class="mt-6 inline-block text-sm font-semibold text-slate-100 hover:text-white" href={project.url} target="_blank" rel="noreferrer">View project →</a>
      </article>
    ))}
  </div>
</section>
