---
const { id, email, message } = Astro.props;
---
<section id={id} class="max-w-5xl mx-auto px-6 py-16">
  <div class="rounded-[1.5rem] bg-white/5 p-10 shadow-[0_18px_50px_rgba(0,0,0,0.05)] text-center">
    <p class="mb-3 text-sm uppercase tracking-[0.2em] text-violet-300">Say hello</p>
    <h2 class="text-3xl font-semibold text-white sm:text-4xl">{message}</h2>
    <a class="mt-8 inline-flex items-center justify-center rounded-full bg-violet-500 px-8 py-4 text-sm font-semibold text-white transition hover:bg-violet-400" href={`mailto:${email}`}>{email}</a>
  </div>
</section>
