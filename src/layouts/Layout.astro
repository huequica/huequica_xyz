---
import "../styles/global.css";
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>huequica.xyz</title>
	</head>
	<body class="min-h-screen bg-slate-950 text-slate-100 antialiased font-sans">
		<div class="page-shell relative min-h-screen overflow-hidden">
			<div class="absolute inset-0 bg-cover bg-center" style="background-image: url('https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=1600&q=80');"></div>
			<div class="absolute inset-0 bg-slate-950/70 backdrop-blur-sm"></div>
			<div class="relative z-10 flex min-h-screen flex-col">
				<header class="sticky top-0 z-20 flex h-20 items-center justify-between gap-6 px-6 bg-slate-950/70 backdrop-blur-2xl border-b border-white/10">
					<div class="brand text-sm uppercase tracking-[0.2em] font-black text-slate-100">huequica.xyz</div>
					<nav class="flex gap-4">
						<a class="text-sm text-slate-300 transition hover:text-slate-100 focus-visible:text-slate-100" href="/">Home</a>
						<a class="text-sm text-slate-300 transition hover:text-slate-100 focus-visible:text-slate-100" href="/about">About</a>
						<a class="text-sm text-slate-300 transition hover:text-slate-100 focus-visible:text-slate-100" href="/projects">Projects</a>
						<a class="text-sm text-slate-300 transition hover:text-slate-100 focus-visible:text-slate-100" href="/contact">Contact</a>
					</nav>
				</header>
				<main class="flex-1">
					<slot />
				</main>
			</div>
		</div>
	</body>
</html>
