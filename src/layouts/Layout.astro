---
import "../styles/global.css";
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>huequica.xyz</title>
	</head>
	<body class="min-h-screen bg-slate-950 text-slate-100 antialiased font-sans">
		<div class="page-shell min-h-screen flex flex-col">
			<header class="sticky top-0 z-20 flex items-center justify-between gap-6 px-6 py-5 backdrop-blur-2xl bg-slate-950/80 border-b border-white/10">
				<div class="brand text-sm uppercase tracking-[0.2em] font-black text-slate-100">huequica.xyz</div>
				<nav class="flex gap-4">
					<a class="text-sm text-slate-400 transition hover:text-slate-100 focus-visible:text-slate-100" href="/">Home</a>
					<a class="text-sm text-slate-400 transition hover:text-slate-100 focus-visible:text-slate-100" href="/about">About</a>
					<a class="text-sm text-slate-400 transition hover:text-slate-100 focus-visible:text-slate-100" href="/projects">Projects</a>
					<a class="text-sm text-slate-400 transition hover:text-slate-100 focus-visible:text-slate-100" href="/contact">Contact</a>
				</nav>
			</header>
			<main class="flex-1">
				<slot />
			</main>
			<footer class="px-6 py-6 text-center text-sm text-slate-500">Built with Astro · Designed for your portfolio</footer>
		</div>
	</body>
</html>
