---
import Layout from "../layouts/Layout.astro";
import SectionHeader from "../components/SectionHeader.tsx";
import SkillPill from "../components/SkillPill.tsx";

const skills = [
  "Astro",
  "React",
  "TypeScript",
  "Accessibility",
  "UI Design",
  "Performance",
];

const summary =
  "I bring polished frontend experiences to life by combining thoughtful design, fast loading interfaces, and modern developer workflows. I enjoy creating responsive sites that feel intuitive on every device.";
---

<Layout>
  <section id="about" class="max-w-5xl mx-auto px-6 py-16">
    <SectionHeader label="About" title="A quick look" />
    <div class="grid gap-10 lg:grid-cols-[1.3fr_0.7fr] lg:items-start">
      <div class="text-slate-300 leading-8">{summary}</div>
      <div class="grid gap-3">
        {skills.map((skill) => (
          <SkillPill skill={skill} />
        ))}
      </div>
    </div>
  </section>
</Layout>
