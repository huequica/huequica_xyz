---
import Layout from "../layouts/Layout.astro";
import SectionHeader from "../components/SectionHeader.tsx";
import ProjectCard from "../components/ProjectCard.tsx";

const projects = [
  {
    name: "Personal portfolio",
    description:
      "A minimal and responsive site to showcase projects, skills, and contact details.",
    type: "Web Design",
    url: "https://github.com/huequica",
  },
  {
    name: "Component library",
    description:
      "Reusable UI components built for performance and maintainability.",
    type: "Frontend",
    url: "https://github.com/huequica",
  },
];
---

<Layout>
  <section id="projects" class="max-w-5xl mx-auto px-6 py-16">
    <SectionHeader label="Projects" title="Selected work" />
    <div class="grid gap-6 sm:grid-cols-2">
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>
</Layout>
