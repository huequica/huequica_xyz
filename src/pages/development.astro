---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Development">
  <section class="max-w-5xl mx-auto px-6 py-16">
    <div class="mb-10 flex flex-col gap-4">
      <p class="text-sm uppercase tracking-[0.2em] text-violet-300">Development</p>
      <h2 class="text-4xl font-semibold tracking-tight text-white sm:text-5xl">Tools, projects, and experiments</h2>
    </div>
    <p class="text-slate-300 leading-8">
      This page is your new home for developer-focused content: open-source projects, experiments, and technical notes. Customize this section with your workflow, favourite tools, and the work you want to highlight.
    </p>
  </section>
</Layout>
