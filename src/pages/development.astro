---
import { SkillPill } from '../components/SkillPill';
import Layout from '../layouts/Layout.astro';

const skills = [
  { name: 'TypeScript', color: { background: 'bg-blue-600' } },
  { name: 'React', color: { background: 'bg-cyan-500' } },
  { name: 'Vue', color: { background: 'bg-green-500' } },
];

// TODO: 代表的なプロジェクトの見せ方が決まったらコメントアウトを外す
// const projects = [
//   {name: "huequica/DiscordTrashedDiver", key: "DiscordTrashedDiver"},
//   {name: "node-jeneralize/pkfire", key: "pkfire"},
//   {name: "node-jeneralize/mti", key: "mti"},
// ]
---

<Layout title="Development">
  <section class="max-w-5xl mx-auto px-6 py-16">
    <div class="mb-10 flex flex-col gap-4">
      <p class="text-sm uppercase tracking-[0.2em] text-violet-300">
        Love Techs
      </p>
      <h2 class="text-4xl font-semibold tracking-tight text-white sm:text-5xl">
        好きな技術
      </h2>
    </div>
    <div class="mt-8 flex flex-wrap gap-4">
      {skills.map((skill) => (
        <SkillPill skill={skill.name} color={skill.color} />
      ))}
    </div>
  </section>
</Layout>
