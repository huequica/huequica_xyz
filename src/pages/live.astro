---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Live">
  <section class="max-w-5xl mx-auto px-6 py-16">
    <div class="mb-10 flex flex-col gap-4">
      <p class="text-sm uppercase tracking-[0.2em] text-violet-300">Live</p>
      <h2 class="text-4xl font-semibold tracking-tight text-white sm:text-5xl">
        Live events and real-time updates
      </h2>
    </div>
    <p class="text-slate-300 leading-8">
      Use this page for live events, behind-the-scenes updates, stream
      announcements, or anything happening in real time. Keep it fresh with your
      latest active projects and appearances.
    </p>
  </section>
</Layout>
