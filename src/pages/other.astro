---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Other">
  <section class="max-w-5xl mx-auto px-6 py-16">
    <div class="mb-10 flex flex-col gap-4">
      <p class="text-sm uppercase tracking-[0.2em] text-violet-300">Other</p>
      <h2 class="text-4xl font-semibold tracking-tight text-white sm:text-5xl">Side projects, hobbies, and extras</h2>
    </div>
    <p class="text-slate-300 leading-8">
      This is a flexible space for anything else you want to share: leisure projects, creative work, or links that don’t fit the other categories.
    </p>
  </section>
</Layout>
