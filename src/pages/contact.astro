---
import {Button} from "../components/Button.tsx";
import {SectionHeader} from "../components/SectionHeader.tsx";
import Layout from "../layouts/Layout.astro";

const email = "hello@huequica.xyz";
const contactMessage = "Let’s build something together.";
---

<Layout>
  <section id="contact" class="max-w-5xl mx-auto px-6 py-16">
    <SectionHeader label="Contact" title="Get in touch" />
    <div class="rounded-[1.5rem] bg-white/5 p-10 shadow-[0_18px_50px_rgba(0,0,0,0.05)] text-center">
      <p class="mb-3 text-sm uppercase tracking-[0.2em] text-violet-300">Say hello</p>
      <h2 class="text-3xl font-semibold text-white sm:text-4xl">{contactMessage}</h2>
      <div class="mt-8">
        <Button href={`mailto:${email}`}>{email}</Button>
      </div>
    </div>
  </section>
</Layout>
