---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Game">
  <section class="max-w-5xl mx-auto px-6 py-16">
    <div class="mb-10 flex flex-col gap-4">
      <p class="text-sm uppercase tracking-[0.2em] text-violet-300">Game</p>
      <h2 class="text-4xl font-semibold tracking-tight text-white sm:text-5xl">Gaming, streams, and play</h2>
    </div>
    <p class="text-slate-300 leading-8">
      This page is for your game-related content. Add your favourite titles, play highlights, stream schedule, or anything that shows your personality in the gaming space.
    </p>
  </section>
</Layout>
